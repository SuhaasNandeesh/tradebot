# ── Broker (Zerodha Kite) ──────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_REQUEST_TOKEN=your_daily_request_token

# Headless TOTP Authentication (run kite_totp_auth.py to use)
KITE_USER_ID=your_zerodha_user_id              # e.g. AB1234
KITE_USER_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_totp_base32_secret       # From Zerodha 2FA setup page

# ── LLM / Cloud Intelligence ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key             # Optional

# ── Local LM Studio (Nemotron / Qwen running locally) ─────────────────────────
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LMSTUDIO_CHAT_MODEL_FAST=nvidia/nemotron-3-nano-4b   # Light tasks: sanity, explain
LMSTUDIO_CHAT_MODEL_DEEP=qwen3.5-4b                  # Deep tasks: reflection, insights

# ── Data / News ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key             # NSE fallback + news search
FIRECRAWL_API_KEY=your_firecrawl_api_key       # Optional web scraping

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_personal_chat_id         # Chat ID where agent broadcasts

# ── Risk Management ───────────────────────────────────────────────────────────
PAPER_TRADE=True                               # Set to False when ready for live capital
MAX_DAILY_LOSS=-5000                           # Circuit breaker threshold (₹)
MAX_POSITION_SIZE=2                            # Max lots per trade
VIX_THRESHOLD=20.0                             # India VIX level to halt new entries

# ── Position & Theta Management ───────────────────────────────────────────────
MAX_HOLD_MINUTES=90                            # Theta exit: stagnant positions after N min
STAGNANT_THRESHOLD_PCT=0.10                    # |P&L| < 10% = stagnant (theta bleeding)
TRAIL_SL_BREAKEVEN_PCT=0.50                    # Move SL to breakeven at 50% profit
TRAIL_SL_TRAIL_PCT=0.80                        # Activate trailing SL at 80% profit
TRAIL_SL_LOCK_PCT=0.60                         # Lock in 60% profit when trailing
EXPIRY_EARLY_EXIT_PCT=0.30                     # Exit on expiry day at 30% of entry

# ── Spread Strategy ───────────────────────────────────────────────────────────
USE_SPREAD_STRATEGY=true                       # Bull/bear spread instead of naked options
SPREAD_SELL_LEG_STRIKES=2                      # Default OTM strikes for sell leg

# ── ChromaDB / RAG Memory ─────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=./chroma_db                # Where semantic embeddings are stored

# ── App Settings ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MOCK_PAPER_CAPITAL=100000.0
